function appendLanguageSwitchParam(url, param, hash) {
	if (!url) {
		return '';
	}
	var separator = url.indexOf('?') === -1 ? '?' : '&';
	return url + separator + param + (hash || '');
}

function changeCountry(id,lan){
    if(MApp(2.2).cookie.set('showtranslate',0)){
        var filePath = MApp(2.2).url.getFilePath();
        var fileArr = filePath.split('/');
        fileArr.shift();
        fileArr.shift();
        var fileUrl = fileArr.join('/');
        var splitPageMap = window.IObitSplitPageMap || {};
        var getLanguageSwitchUrl = typeof window.getIObitLanguageSwitchUrl === 'function' ? window.getIObitLanguageSwitchUrl : null;
        var switchUrl = getLanguageSwitchUrl ? getLanguageSwitchUrl(lan, '') : '';
        var switchUrlEn = getLanguageSwitchUrl ? getLanguageSwitchUrl('en', '') : '';
        if(splitPageMap[fileUrl]){
            fileUrl = splitPageMap[fileUrl];
        }
        if(lan=='my'||lan=='th'||lan=='hi'||lan=='ms'||lan=='id'||lan=='ko'){
            MApp(2.2).cookie.set('showtranslate',1);
            var url = switchUrlEn ? appendLanguageSwitchParam(switchUrlEn, 'r', '#googtrans('+lan+')') : 'https://'+document.domain +  '/en/' + fileUrl +'?r#googtrans('+lan+')';
            location.href = url;
        }else if(lan=='jp'){
            var url = switchUrl || 'https://jp.iobit.com/?utm_source=www.iobit.com';
            location.href = url;
        }else if(lan=='ru'){
			if(switchUrl){
				location.href = switchUrl;
			}else{
				if(fileUrl=='index.php'){
					var url = 'https://ru.iobit.com/';
				}else{
					var url = 'https://ru.iobit.com/' + fileUrl;
				}
	            location.href = url;
			}
        }else{
            MApp(2.2).cookie.remove('country');
            if(MApp(2.2).cookie.set('country',id)){
				MApp(2.2).cookie.set('changecountry',1);
                if(switchUrl){
                    location.href = switchUrl;
                }else{
                    var url = 'https://'+document.domain +  '/' + lan + '/' + fileUrl+'?b1';
                    location.href = url;
                }
            }
        }
    }
	
}

